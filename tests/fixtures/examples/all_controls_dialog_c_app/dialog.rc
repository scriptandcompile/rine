#include <windows.h>
#include <commctrl.h>

#define IDD_ALL_CONTROLS_DIALOG 3001

#define IDC_BTN_PUSH 3101
#define IDC_CHK_OPTION 3102
#define IDC_RAD_ONE 3103
#define IDC_RAD_TWO 3104
#define IDC_EDIT_SINGLE 3105
#define IDC_EDIT_PASSWORD 3106
#define IDC_EDIT_MULTI 3107
#define IDC_LISTBOX 3108
#define IDC_COMBOBOX 3109
#define IDC_SCROLL_H 3110
#define IDC_SCROLL_V 3111
#define IDC_LISTVIEW 3112
#define IDC_TREEVIEW 3113
#define IDC_TAB 3114
#define IDC_PROGRESS 3115
#define IDC_TRACKBAR 3116
#define IDC_UPDOWN_EDIT 3117
#define IDC_UPDOWN 3118
#define IDC_DATETIME 3119
#define IDC_MONTHCAL 3120
#define IDC_HOTKEY 3121
#define IDC_HEADER 3122

IDD_ALL_CONTROLS_DIALOG DIALOGEX 0, 0, 600, 430
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "all_controls_dialog_c_app"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Dialog fixture with broad control coverage", -1, 8, 8, 270, 10

    GROUPBOX    "Classic controls", -1, 8, 22, 160, 96
    PUSHBUTTON  "Push", IDC_BTN_PUSH, 16, 36, 64, 14
    CONTROL     "Checkbox", IDC_CHK_OPTION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 56, 68, 10
    CONTROL     "Radio 1", IDC_RAD_ONE, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 16, 72, 58, 10
    CONTROL     "Radio 2", IDC_RAD_TWO, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 86, 72, 58, 10

    GROUPBOX    "Edit controls", -1, 176, 22, 188, 96
    EDITTEXT    IDC_EDIT_SINGLE, 184, 36, 172, 14, ES_AUTOHSCROLL
    EDITTEXT    IDC_EDIT_PASSWORD, 184, 56, 172, 14, ES_AUTOHSCROLL | ES_PASSWORD
    EDITTEXT    IDC_EDIT_MULTI, 184, 76, 172, 34, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL

    GROUPBOX    "List controls", -1, 8, 124, 172, 132
    LISTBOX     IDC_LISTBOX, 16, 138, 74, 80, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    COMBOBOX    IDC_COMBOBOX, 96, 138, 76, 72, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    CONTROL     "", IDC_SCROLL_H, "ScrollBar", SBS_HORZ | WS_TABSTOP, 16, 224, 156, 12
    CONTROL     "", IDC_SCROLL_V, "ScrollBar", SBS_VERT | WS_TABSTOP, 156, 138, 12, 80

    GROUPBOX    "Common controls", -1, 188, 124, 404, 260
    CONTROL     "", IDC_LISTVIEW, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT, 196, 138, 168, 84
    CONTROL     "", IDC_TREEVIEW, "SysTreeView32", WS_TABSTOP | WS_BORDER | TVS_HASLINES | TVS_LINESATROOT, 372, 138, 104, 84
    CONTROL     "", IDC_TAB, "SysTabControl32", WS_TABSTOP, 484, 138, 100, 84

    CONTROL     "", IDC_PROGRESS, "msctls_progress32", WS_VISIBLE, 196, 228, 168, 12
    CONTROL     "", IDC_TRACKBAR, "msctls_trackbar32", WS_TABSTOP | TBS_AUTOTICKS, 196, 246, 168, 20

    EDITTEXT    IDC_UPDOWN_EDIT, 372, 228, 52, 14, ES_NUMBER | WS_TABSTOP
    CONTROL     "", IDC_UPDOWN, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS, 0, 0, 0, 0

    CONTROL     "", IDC_DATETIME, "SysDateTimePick32", WS_TABSTOP, 432, 228, 152, 14
    CONTROL     "", IDC_MONTHCAL, "SysMonthCal32", WS_TABSTOP, 372, 246, 212, 120

    CONTROL     "", IDC_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 196, 272, 90, 14
    CONTROL     "", IDC_HEADER, "SysHeader32", HDS_BUTTONS, 196, 292, 168, 14

    DEFPUSHBUTTON "OK", IDOK, 476, 406, 54, 14
    PUSHBUTTON  "Cancel", IDCANCEL, 536, 406, 54, 14
END
