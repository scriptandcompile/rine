#include <windows.h>

#define IDD_MAIN_DIALOG 2001
#define IDC_NAME_EDIT 2002
#define IDC_UPPER_CHECK 2003

IDD_MAIN_DIALOG DIALOGEX 0, 0, 220, 100
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "modal_dialog_c_app"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Name:", -1, 10, 13, 28, 8
    EDITTEXT    IDC_NAME_EDIT, 44, 11, 166, 14, ES_AUTOHSCROLL
    CONTROL     "Uppercase", IDC_UPPER_CHECK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 44, 33, 62, 10
    DEFPUSHBUTTON "OK", IDOK, 105, 78, 50, 14
    PUSHBUTTON  "Cancel", IDCANCEL, 160, 78, 50, 14
END
